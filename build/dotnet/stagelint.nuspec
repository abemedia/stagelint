<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>stagelint.$rid$</id>
    <version>$version$</version>
    <authors>Adam Bouqdib</authors>
    <description>Run commands like linters and formatters on staged git files</description>
    <license type="expression">MIT</license>
    <projectUrl>https://stagelint.dev</projectUrl>
    <repository type="git" url="https://github.com/abemedia/stagelint" />
    <readme>README.md</readme>
    <tags>git hooks pre-commit lint format</tags>
    <packageTypes>
      <packageType name="DotnetToolRidPackage" />
    </packageTypes>
  </metadata>
  <files>
    <file src="README.md" target="" />
    <file src="target/$triple$/release/$bin$" target="tools/any/$rid$/$bin$" />
    <file src="build/dotnet/DotnetToolSettings.$settings$.xml" target="tools/any/$rid$/DotnetToolSettings.xml" />
  </files>
</package>
